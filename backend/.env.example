# Server Configuration
PORT=5000

# Database Configuration
# Using 127.0.0.1 to connect to the MongoDB container running in Docker
MONGO_URI=mongodb://127.0.0.1:27017/ai_learning_platform

# Authentication (JWT)
JWT_SECRET=your_jwt_secret_key_here

# AI Service Configuration
OPENAI_API_KEY=your_openai_api_key_here